#!/bin/bash
# Fake codex CLI for testing aegis integration.
# Mimics the claude fake CLI pattern.

set -e

# Handle special flags
for arg in "$@"; do
    case "$arg" in
        --version)
            echo "fake-codex version 1.0.0-test"
            exit 0
            ;;
        --help)
            echo "Usage: fake-codex [options]"
            echo "A fake Codex CLI for testing aegis sandbox."
            exit 0
            ;;
    esac
done

echo "fake-codex: running with args: $*"
exit 0
